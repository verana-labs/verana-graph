# PostgreSQL connection (docker-compose default below)
DATABASE_URL=postgres://verana:verana@localhost:5433/verana_graph

# Upstream Verana Indexer
INDEXER_BASE_URL=http://localhost:3000
# ws:// derived from INDEXER_BASE_URL when unset
INDEXER_WS_URL=

# HTTP + WS listen port of the graph service
PORT=3100

# Optional resource fetching (TG-DEREF-2a/2b, TG-DEREF-3)
FETCH_GF_DOC_BODIES=false
FETCH_VP_BODIES=false

# Gap-recovery coalescing threshold in blocks (TG-INGEST-5 MAY)
GAP_COALESCE_THRESHOLD=1000

# Slow BPS client disconnect threshold in bytes (TG-BPS-6)
BPS_MAX_BUFFERED_BYTES=1048576

LOG_LEVEL=info

# Trust-refresh sweep (NOT in the spec; see IMPLEMENTATION-NOTES). Re-resolves DIDs whose
# trust evaluation has expired, so the discovery surface does not go dark on a quiet chain.
# Set to 0 to follow the spec literally (event-driven resolves only).
TRUST_REFRESH_INTERVAL_MS=300000
TRUST_REFRESH_BATCH=200
