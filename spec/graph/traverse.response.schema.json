{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verana.io/schemas/v4/graph/traverse/response.schema.json",
  "title": "TraverseResponse",
  "description": "Response payload for the verana-graph canonical traversal queries [TG-QRY-3]. The single endpoint `POST /v4/graph/traverse` returns a per-query `output` shape mirroring the **Output (shape)** column of the [TG-QRY-3] tables. Every entity reference carries its primary key, `lastObservedAtTime`, and the visibility flags applicable to its type (`isTrustExpired` for `Did`, `archived` for `Ecosystem` / `CredentialSchema`). All datetime values are ISO 8601 / RFC 3339 UTC strings (see `#/$defs/Iso8601DateTime`). See `### Traversal REST binding` in the verana-graph spec.",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "evaluatedAtTime", "output"],
  "properties": {
    "query": { "$ref": "#/$defs/TraversalQueryId" },
    "evaluatedAtTime": { "$ref": "#/$defs/Iso8601DateTime", "description": "Wall-clock evaluation time of the response. Per [[TG-QRY-1]] the graph evaluates against its current persisted state; this timestamp is the moment the call was answered." },
    "output": {
      "description": "Per-query output shape; constrained by the discriminated `allOf` branch matching `query`."
    }
  },
  "allOf": [
    { "if": { "properties": { "query": { "const": "A1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A1Output" } } } },
    { "if": { "properties": { "query": { "const": "A2" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A2Output" } } } },
    { "if": { "properties": { "query": { "const": "A3" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A3Output" } } } },
    { "if": { "properties": { "query": { "const": "A4" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A4Output" } } } },
    { "if": { "properties": { "query": { "const": "A5" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A5Output" } } } },
    { "if": { "properties": { "query": { "const": "A6" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A6Output" } } } },
    { "if": { "properties": { "query": { "const": "A7" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/A7Output" } } } },
    { "if": { "properties": { "query": { "const": "B1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/B1Output" } } } },
    { "if": { "properties": { "query": { "const": "B2" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/B2Output" } } } },
    { "if": { "properties": { "query": { "const": "C1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/C1Output" } } } },
    { "if": { "properties": { "query": { "const": "C2" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/RoleToDidsOutput" } } } },
    { "if": { "properties": { "query": { "const": "C3" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/C3Output" } } } },
    { "if": { "properties": { "query": { "const": "D1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/D1Output" } } } },
    { "if": { "properties": { "query": { "const": "D2" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/RoleToDidsOutput" } } } },
    { "if": { "properties": { "query": { "const": "E1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/E1Output" } } } },
    { "if": { "properties": { "query": { "const": "E2" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/E2Output" } } } },
    { "if": { "properties": { "query": { "const": "E3" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/E3Output" } } } },
    { "if": { "properties": { "query": { "const": "F1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/F1Output" } } } },
    { "if": { "properties": { "query": { "const": "G1" } } }, "then": { "properties": { "output": { "$ref": "#/$defs/G1Output" } } } }
  ],
  "$defs": {
    "TraversalQueryId": {
      "enum": ["A1", "A2", "A3", "A4", "A5", "A6", "A7", "B1", "B2", "C1", "C2", "C3", "D1", "D2", "E1", "E2", "E3", "F1", "G1"]
    },
    "Iso8601DateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "ISO 8601 / RFC 3339 datetime string in UTC. MUST include the date, the time (with seconds), and the trailing `Z` UTC designator. Fractional seconds are OPTIONAL. Local times, non-UTC offsets, date-only values, and timezone-less times are NOT permitted."
    },
    "Bech32Address": {
      "type": "string",
      "pattern": "^verana1[a-z0-9]+$",
      "description": "Cosmos bech32 address with the `verana` HRP. Used for the per-Participant `vsOperator` account and for `Corporation.policyAddress`; NOT used as a primary key (Corporation, Ecosystem, CredentialSchema, and Participant primary keys are all `uint64` VPR ledger ids)."
    },
    "Coin": {
      "type": "string",
      "pattern": "^[0-9]+[a-z][a-z0-9]*$",
      "description": "Cosmos coin amount-denom pair, e.g. `10000000uvna`."
    },
    "DigestSri": {
      "type": "string",
      "pattern": "^sha(256|384|512)-",
      "description": "Subresource Integrity digest in the standard `algo-base64` form."
    },
    "DidString": {
      "type": "string",
      "pattern": "^did:"
    },
    "Pattern": {
      "enum": ["A", "B"],
      "description": "Architecture pattern per VS-REQ-3 / VS-REQ-4 (A: self-issued; B: delegated)."
    },
    "ParticipantState": {
      "enum": ["ACTIVE", "FUTURE", "INACTIVE", "EXPIRED", "REVOKED", "SLASHED", "REPAID"]
    },
    "ParticipantRole": {
      "enum": ["HOLDER", "ISSUER", "VERIFIER", "ISSUER_GRANTOR", "VERIFIER_GRANTOR", "ECOSYSTEM"]
    },
    "EcsSchemaName": {
      "enum": ["ServiceCredential", "OrganizationCredential", "PersonaCredential", "UserAgentCredential"]
    },
    "EntityType": {
      "enum": ["Did", "Corporation", "Ecosystem", "CredentialSchema", "Participant", "EcsCredential", "Vtc", "LinkedVerifiablePresentation", "ServiceEndpoint"]
    },
    "EntityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "$ref": "#/$defs/EntityType" },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer", "minimum": 0 }
          ]
        }
      }
    },
    "GovernanceFramework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "documents"],
      "description": "Active Governance Framework (CGF on a Corporation, EGF on an Ecosystem). Mirrors the indexer-side `GovernanceFramework` shape.",
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "activeSince": { "$ref": "#/$defs/Iso8601DateTime" },
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["language", "url", "digestSri"],
            "properties": {
              "language": { "type": "string", "description": "BCP 47 language tag." },
              "url": { "type": "string", "format": "uri" },
              "digestSri": { "$ref": "#/$defs/DigestSri" }
            }
          }
        }
      }
    },
    "DidRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "lastObservedAtTime", "isTrustExpired"],
      "description": "Minimal Did reference. `isTrustExpired` is the [[TG-ACT-3]] visibility flag; per [[TG-QRY-3]] every entity reference MUST carry the visibility flags applicable to its type, and it is always computable as `expiresAtTime` non-null and `< now`.",
      "properties": {
        "did": { "$ref": "#/$defs/DidString" },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" },
        "isTrustExpired": { "type": "boolean" },
        "pattern": { "$ref": "#/$defs/Pattern" },
        "trusted": { "type": "boolean" },
        "corporationId": { "type": ["integer", "null"], "minimum": 0, "description": "Stable `uint64` id of the Corporation that owns this DID (mirrors VPR `Corporation.id`). `null` while no Corporation has adopted the DID." }
      }
    },
    "CorporationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lastObservedAtTime"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "description": "Stable `uint64` primary key of the Corporation (mirrors VPR `Corporation.id`)." },
        "policyAddress": { "$ref": "#/$defs/Bech32Address", "description": "On-chain account that signs on behalf of this Corporation (mirrors VPR `Corporation.policy_address`). Globally unique across all Corporation entries. MAY be backed by any signing primitive (single key, multisig, Cosmos SDK group policy, …)." },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" },
        "deposit": { "$ref": "#/$defs/Coin" },
        "lastSlashedAtTime": { "$ref": "#/$defs/Iso8601DateTime" },
        "slashedEvents": { "type": "integer", "minimum": 0 },
        "slashedValue": { "$ref": "#/$defs/Coin" },
        "cgf": { "$ref": "#/$defs/GovernanceFramework" }
      }
    },
    "EcosystemRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "corporationId", "archived", "lastObservedAtTime"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "corporationId": { "type": "integer", "minimum": 0, "description": "Stable `uint64` id of the Corporation that controls this Ecosystem (mirrors VPR `Ecosystem.corporation_id`)." },
        "archived": { "type": "boolean" },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" },
        "egf": { "$ref": "#/$defs/GovernanceFramework" },
        "issuedCredentials": { "type": "integer", "minimum": 0 },
        "verifiedCredentials": { "type": "integer", "minimum": 0 }
      }
    },
    "CredentialSchemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "digestSri", "archived", "lastObservedAtTime"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "type": { "const": "JsonSchema" },
        "digestSri": { "$ref": "#/$defs/DigestSri" },
        "archived": { "type": "boolean" },
        "ecosystemId": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "ParticipantRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "state", "credentialSchemaId", "ecosystemId", "validatorParticipantId", "lastObservedAtTime"],
      "description": "Minimal Participant reference. Per [[TG-ACT-1]] only `state = ACTIVE` records are persisted; non-ACTIVE values MUST NOT appear here. `validatorParticipantId` anchors the `VALIDATED_BY: Participant → Participant` edge (the parent node in the permission tree); it is `null` if and only if `role = ECOSYSTEM` (the chain root, per [[TG-EDGE-4]]).",
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "vsOperator": { "anyOf": [{ "$ref": "#/$defs/Bech32Address" }, { "type": "null" }], "description": "`null` until a VS Operator Authorization has been granted for this entry." },
        "role": { "$ref": "#/$defs/ParticipantRole" },
        "state": { "$ref": "#/$defs/ParticipantState" },
        "credentialSchemaId": { "type": "integer", "minimum": 0 },
        "ecosystemId": { "type": "integer", "minimum": 0 },
        "weight": { "$ref": "#/$defs/Coin" },
        "issuedCredentials": { "type": "integer", "minimum": 0 },
        "verifiedCredentials": { "type": "integer", "minimum": 0 },
        "validatorParticipantId": { "type": ["integer", "null"], "minimum": 0, "description": "Stable VPR id of the validator Participant (parent in the permission tree). `null` iff `role = ECOSYSTEM`; non-negative integer otherwise. The graph persists the value as received from the indexer; the role-conditional rule is enforced upstream at the indexer's ingress." },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "EcsCredentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecsSchema", "ecsSchemaVersion", "credentialSchemaId", "issuerParticipantId", "ecosystemId", "participantId", "validFrom", "validUntil", "credentialSubject", "lastObservedAtTime"],
      "properties": {
        "ecsSchema": { "$ref": "#/$defs/EcsSchemaName" },
        "ecsSchemaVersion": { "type": "string" },
        "credentialSchemaId": { "type": "integer", "minimum": 0 },
        "issuerParticipantId": { "type": "integer", "minimum": 0 },
        "ecosystemId": { "type": "integer", "minimum": 0 },
        "participantId": { "type": "integer", "minimum": 0 },
        "id": { "type": "string" },
        "validFrom": { "$ref": "#/$defs/Iso8601DateTime" },
        "validUntil": { "anyOf": [{ "$ref": "#/$defs/Iso8601DateTime" }, { "type": "null" }], "description": "`null` for open-ended credentials, per the entity table (`timestamp | null`)." },
        "credentialSubject": { "type": "object", "description": "ECS-schema-specific subject claims; always includes `id`." },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "VtcRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "credentialSchemaId", "ecosystemId", "participantId", "issuerParticipantId", "lastObservedAtTime"],
      "properties": {
        "id": { "type": "string" },
        "credentialSchemaId": { "type": "integer", "minimum": 0 },
        "ecosystemId": { "type": "integer", "minimum": 0 },
        "participantId": { "type": "integer", "minimum": 0 },
        "issuerParticipantId": { "type": "integer", "minimum": 0 },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "LinkedVerifiablePresentationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lastObservedAtTime"],
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "serviceId": { "$ref": "#/$defs/DidString" },
        "vtcs": { "type": "array", "items": { "$ref": "#/$defs/VtcRef" } },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "ServiceEndpointRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "serviceEndpoint", "lastObservedAtTime"],
      "properties": {
        "id": { "$ref": "#/$defs/DidString" },
        "type": { "type": "string" },
        "serviceEndpoint": {
          "anyOf": [
            { "type": "string", "format": "uri" },
            { "type": "object" }
          ]
        },
        "accept": { "type": "array", "items": { "type": "string" } },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "CredentialAnyRef": {
      "oneOf": [
        { "$ref": "#/$defs/EcsCredentialRef" },
        { "$ref": "#/$defs/VtcRef" }
      ],
      "description": "Either an EcsCredential or a Vtc record. The graph dispatches on the actual stored shape."
    },
    "A1Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "trusted", "evaluatedAtTime", "evaluatedAtBlock", "expiresAtTime", "pattern", "isTrustExpired", "corporationId", "lastObservedAtTime"],
      "description": "A1 \u2014 Trust summary. Mirrors the trust-core fields the indexer surfaces under `/v4/verifiable-trust/resolve` for this DID, plus the graph-level `lastObservedAtTime`.",
      "properties": {
        "did": { "$ref": "#/$defs/DidString" },
        "trusted": { "type": "boolean" },
        "evaluatedAtTime": { "$ref": "#/$defs/Iso8601DateTime" },
        "evaluatedAtBlock": { "type": "integer", "minimum": 0 },
        "expiresAtTime": { "oneOf": [{ "$ref": "#/$defs/Iso8601DateTime" }, { "type": "null" }], "description": "Earliest trust-flipping boundary per [IDX-VT-EVAL-2]; `null` when no boundary exists (never trust-expires until an upstream re-evaluation)." },
        "pattern": { "$ref": "#/$defs/Pattern" },
        "isTrustExpired": { "type": "boolean" },
        "corporationId": { "type": ["integer", "null"], "minimum": 0, "description": "Stable `uint64` id of the Corporation that owns this DID (mirrors VPR `Corporation.id`). `null` while no Corporation has adopted the DID." },
        "lastObservedAtTime": { "$ref": "#/$defs/Iso8601DateTime" }
      }
    },
    "A2Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corporation", "ecosystems"],
      "description": "A2 \u2014 Governing chain. Owning Corporation and the deduplicated set of Ecosystems whose schemas the DID participates in.",
      "properties": {
        "corporation": { "anyOf": [{ "$ref": "#/$defs/CorporationRef" }, { "type": "null" }], "description": "`null` when `Did.corporationId` is `null` (no Corporation has adopted the DID)." },
        "ecosystems": { "type": "array", "items": { "$ref": "#/$defs/EcosystemRef" } }
      }
    },
    "A3Output": {
      "type": "array",
      "items": { "$ref": "#/$defs/ServiceEndpointRef" },
      "description": "A3 \u2014 Service endpoints (DID Document `service[]` excluding LinkedVerifiablePresentation entries)."
    },
    "A4Output": {
      "type": "array",
      "items": { "$ref": "#/$defs/LinkedVerifiablePresentationRef" },
      "description": "A4 \u2014 Linked VPs and their contained VTCs."
    },
    "A5Output": {
      "type": "array",
      "description": "A5 \u2014 Held credentials (DID is subject), each enriched with issuer/schema/ecosystem context.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["credential", "schema", "ecosystem"],
        "properties": {
          "credential": { "$ref": "#/$defs/EcsCredentialRef" },
          "issuerDid": { "$ref": "#/$defs/DidString" },
          "issuerParticipant": { "$ref": "#/$defs/ParticipantRef" },
          "schema": { "$ref": "#/$defs/CredentialSchemaRef" },
          "ecosystem": { "$ref": "#/$defs/EcosystemRef" }
        }
      }
    },
    "A6Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecsCredentials", "vtcs"],
      "description": "A6 \u2014 Issued credentials (DID is issuer). Both EcsCredential and Vtc records, each enriched with subject/schema/ecosystem context.",
      "properties": {
        "ecsCredentials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["credential", "schema", "ecosystem"],
            "properties": {
              "credential": { "$ref": "#/$defs/EcsCredentialRef" },
              "subjectDid": { "$ref": "#/$defs/DidString" },
              "schema": { "$ref": "#/$defs/CredentialSchemaRef" },
              "ecosystem": { "$ref": "#/$defs/EcosystemRef" }
            }
          }
        },
        "vtcs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["credential", "schema", "ecosystem"],
            "properties": {
              "credential": { "$ref": "#/$defs/VtcRef" },
              "subjectDid": { "$ref": "#/$defs/DidString" },
              "schema": { "$ref": "#/$defs/CredentialSchemaRef" },
              "ecosystem": { "$ref": "#/$defs/EcosystemRef" }
            }
          }
        }
      }
    },
    "A7Output": {
      "type": "array",
      "description": "A7 \u2014 Participants by role, each accompanied by its schema and ecosystem context.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["participant", "schema", "ecosystem"],
        "properties": {
          "participant": { "$ref": "#/$defs/ParticipantRef" },
          "schema": { "$ref": "#/$defs/CredentialSchemaRef" },
          "ecosystem": { "$ref": "#/$defs/EcosystemRef" }
        }
      }
    },
    "B1Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "issuerDid", "issuerParticipant", "schema", "ecosystem"],
      "description": "B1 \u2014 Issuer recovery for a credential surfaced in the graph (per [[TG-INGEST-6]]).",
      "properties": {
        "credential": { "$ref": "#/$defs/CredentialAnyRef" },
        "issuerDid": { "$ref": "#/$defs/DidString" },
        "issuerParticipant": { "$ref": "#/$defs/ParticipantRef" },
        "schema": { "$ref": "#/$defs/CredentialSchemaRef" },
        "ecosystem": { "$ref": "#/$defs/EcosystemRef" }
      }
    },
    "B2Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential", "subjectDid", "holderParticipant"],
      "description": "B2 \u2014 Holder recovery for a credential surfaced in the graph.",
      "properties": {
        "credential": { "$ref": "#/$defs/CredentialAnyRef" },
        "subjectDid": { "$ref": "#/$defs/DidString" },
        "holderParticipant": { "$ref": "#/$defs/ParticipantRef" }
      }
    },
    "C1Output": {
      "type": "array",
      "items": { "$ref": "#/$defs/CredentialSchemaRef" },
      "description": "C1 \u2014 Schemas owned by the Ecosystem (1:1 schema \u2192 ecosystem)."
    },
    "RoleToDidsOutput": {
      "type": "object",
      "additionalProperties": false,
      "description": "C2 / D2 \u2014 Participating DIDs grouped by role. Each role key MAY be omitted when no participants of that role exist.",
      "properties": {
        "HOLDER": { "$ref": "#/$defs/RoleParticipantsArray" },
        "ISSUER": { "$ref": "#/$defs/RoleParticipantsArray" },
        "VERIFIER": { "$ref": "#/$defs/RoleParticipantsArray" },
        "ISSUER_GRANTOR": { "$ref": "#/$defs/RoleParticipantsArray" },
        "VERIFIER_GRANTOR": { "$ref": "#/$defs/RoleParticipantsArray" },
        "ECOSYSTEM": { "$ref": "#/$defs/RoleParticipantsArray" }
      }
    },
    "RoleParticipantsArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["did", "participant"],
        "properties": {
          "did": { "$ref": "#/$defs/DidRef" },
          "participant": { "$ref": "#/$defs/ParticipantRef" }
        }
      }
    },
    "C3Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egf"],
      "description": "C3 \u2014 Ecosystem Governance Framework summary; document bodies are surfaced only if locally fetched.",
      "properties": {
        "egf": { "$ref": "#/$defs/GovernanceFramework" }
      }
    },
    "D1Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecsCredentials", "vtcs"],
      "description": "D1 \u2014 Credentials based on the schema (both ECS credentials and Vtcs).",
      "properties": {
        "ecsCredentials": { "type": "array", "items": { "$ref": "#/$defs/EcsCredentialRef" } },
        "vtcs": { "type": "array", "items": { "$ref": "#/$defs/VtcRef" } }
      }
    },
    "E1Output": {
      "type": "array",
      "items": { "$ref": "#/$defs/DidRef" },
      "description": "E1 \u2014 DIDs owned by the Corporation."
    },
    "E2Output": {
      "type": "array",
      "items": { "$ref": "#/$defs/EcosystemRef" },
      "description": "E2 \u2014 Ecosystems controlled by the Corporation."
    },
    "E3Output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cgf"],
      "description": "E3 \u2014 Corporation Governance Framework summary; document bodies are surfaced only if locally fetched.",
      "properties": {
        "cgf": { "$ref": "#/$defs/GovernanceFramework" }
      }
    },
    "F1Output": {
      "oneOf": [
        {
          "type": "array",
          "description": "F1 \u2014 Shortest trust path. Ordered sequence of `(node, edge)` steps; the final step's `edge` MAY be omitted when the path terminates at the target node.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node"],
            "properties": {
              "node": { "$ref": "#/$defs/EntityRef" },
              "edge": { "type": "string", "description": "Edge label per [Edges](#edges) (e.g. `OPERATED_BY`, `PARTICIPATES_IN`, `FOR_SCHEMA`, `OWNS_SCHEMA`)." }
            }
          }
        },
        { "type": "null", "description": "No path exists between `from` and `to` in the current graph." }
      ]
    },
    "G1Output": {
      "type": "array",
      "description": "G1 — Validator chain. Ordered `ParticipantRef[]` from **root to leaf inclusive**: the first element has `role = ECOSYSTEM` and `validatorParticipantId = null` (the permission-tree root for the input Participant's Ecosystem; see [[TG-EDGE-4]]); the last element is the input Participant itself. Every element's `ecosystemId` MUST be identical (a validator chain never crosses Ecosystem boundaries). If the input Participant is itself the ECOSYSTEM root, this is a 1-element array containing only the input.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ParticipantRef" }
    }
  }
}
