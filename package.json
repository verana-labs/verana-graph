{
  "name": "verana-graph",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Verana Graph: read-only discovery index over the Verana Indexer (spec v4)",
  "homepage": "https://verana.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/verana-labs/verana-graph"
  },
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/fix-imports.cjs && cp -R src/deref/contexts dist/deref/contexts",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "check-types": "tsc --noEmit",
    "format": "biome format --write .",
    "check-format": "biome check .",
    "lint": "biome lint --write .",
    "validate": "pnpm lint && pnpm check-types && pnpm check-format",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:all": "vitest run",
    "prepare": "corepack enable",
    "test:db": "vitest run test/integration"
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "^4.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "didwebvh-ts": "2.8.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.2.1",
    "jsonld-signatures": "11.6.0",
    "knex": "^3.1.0",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "swagger-ui-dist": "^5.32.14",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/node": "^20.11.19",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-dist": "^3.30.6",
    "@types/ws": "^8.5.13",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">= 20"
  },
  "packageManager": "pnpm@9.15.3"
}
